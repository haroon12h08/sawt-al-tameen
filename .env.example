# Copy to .env (git-ignored) and fill in. Never commit real values.

# Database: SQLite locally; a hosted Postgres URL (e.g. Neon free tier) for an always-on deployment.
PREAUTH_DATABASE_URL=sqlite:///./preauth.db

# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
PREAUTH_VOICE_AGENT_TOKEN=
PREAUTH_GATEWAY_SECRET=
# Shown by ElevenLabs when you create the post-call webhook.
PREAUTH_ELEVENLABS_WEBHOOK_SECRET=

# Only for scripts/elevenlabs_setup.py
ELEVENLABS_API_KEY=
PREAUTH_PUBLIC_BASE_URL=
